# Copy to .env for local development: `cp .env.example .env`
#
# Host ports are the service defaults plus 10000, so this stack never collides with a
# Postgres or Redis another project already has running on your machine.

APP_ENV=development
APP_SERVICE_NAME=myjobfyt
APP_VERSION=dev

# --- HTTP -------------------------------------------------------------------
HTTP_ADDR=:18080
HTTP_CORS_ORIGINS=http://localhost:13000
HTTP_TRUST_PROXY_HEADERS=false

# --- logging ----------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_ADD_SOURCE=true

# --- Postgres ---------------------------------------------------------------
POSTGRES_DSN=postgres://myjobfyt:myjobfyt@localhost:15432/myjobfyt?sslmode=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2

# --- Redis ------------------------------------------------------------------
REDIS_ADDR=localhost:16379

# --- NATS -------------------------------------------------------------------
NATS_URL=nats://localhost:14222
NATS_STREAM_REPLICAS=1

# --- object storage (MinIO) -------------------------------------------------
STORAGE_ENDPOINT=localhost:19000
STORAGE_ACCESS_KEY=myjobfyt
STORAGE_SECRET_KEY=myjobfyt-dev-secret
STORAGE_BUCKET=myjobfyt-cvs
STORAGE_USE_SSL=false
STORAGE_MAX_CV_BYTES=10485760

# --- auth -------------------------------------------------------------------
# Generate a development keypair with: make keys
# In production these come from a secret manager, never from a file in the repo.
AUTH_JWT_PRIVATE_KEY_PEM=
AUTH_JWT_PUBLIC_KEY_PEM=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_COOKIE_SECURE=false

# --- mail (Mailpit catches everything; UI at http://localhost:18025) --------
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_FROM=no-reply@myjobfyt.local
SMTP_FROM_NAME=MyJobFyt

# --- telemetry --------------------------------------------------------------
TELEMETRY_ENABLED=false
METRICS_ADDR=:19090

# --- worker -----------------------------------------------------------------
WORKER_GROUPS=cv,jobs,matching,applications,outreach
WORKER_CONCURRENCY=4

# --- antivirus --------------------------------------------------------------
# Empty uses the development pass-through scanner, which marks every upload
# clean without examining it. Production refuses to start without a real one.
# Start ClamAV with: docker compose --profile full up -d clamav
ANTIVIRUS_ADDR=
ANTIVIRUS_TIMEOUT=60s

# --- document extraction ----------------------------------------------------
EXTRACT_MAX_PAGES=20
EXTRACT_MAX_CHARS=200000

# --- worker -----------------------------------------------------------------
# The worker binds its own metrics port, separate from the API's.
WORKER_METRICS_ADDR=:19092
