# Copy to .env for local development: `cp .env.example .env`
#
# Host ports are the service defaults plus 10000, so this stack never collides with a
# Postgres or Redis another project already has running on your machine.

APP_ENV=development
APP_SERVICE_NAME=myjobfyt
APP_VERSION=dev

# --- HTTP -------------------------------------------------------------------
HTTP_ADDR=:18080
HTTP_CORS_ORIGINS=http://localhost:13000
HTTP_TRUST_PROXY_HEADERS=false

# --- logging ----------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_ADD_SOURCE=true

# --- Postgres ---------------------------------------------------------------
POSTGRES_DSN=postgres://myjobfyt:myjobfyt@localhost:15432/myjobfyt?sslmode=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2

# --- Redis ------------------------------------------------------------------
REDIS_ADDR=localhost:16379

# --- NATS -------------------------------------------------------------------
NATS_URL=nats://localhost:14222
NATS_STREAM_REPLICAS=1

# --- object storage (MinIO) -------------------------------------------------
STORAGE_ENDPOINT=localhost:19000
STORAGE_ACCESS_KEY=myjobfyt
STORAGE_SECRET_KEY=myjobfyt-dev-secret
STORAGE_BUCKET=myjobfyt-cvs
STORAGE_USE_SSL=false
STORAGE_MAX_CV_BYTES=10485760

# --- auth -------------------------------------------------------------------
# Generate a development keypair with: make keys
# In production these come from a secret manager, never from a file in the repo.
AUTH_JWT_PRIVATE_KEY_PEM=
AUTH_JWT_PUBLIC_KEY_PEM=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_COOKIE_SECURE=false

# --- mail (Mailpit catches everything; UI at http://localhost:18025) --------
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_FROM=no-reply@myjobfyt.local
SMTP_FROM_NAME=MyJobFyt

# --- telemetry --------------------------------------------------------------
TELEMETRY_ENABLED=false

# Where to export traces, as host:port with no scheme. EMPTY MEANS SPANS ARE NOT
# RECORDED AT ALL: otel.Tracer() falls back to a no-op, every span the code creates is
# discarded, and the trace context the event envelopes carry is empty. The code reads as
# instrumented either way, so this is the difference between the pipeline being
# traceable and merely looking traceable.
#
# Start the collector with: docker compose --profile observability up -d
# Then view traces in Grafana (http://localhost:13001) against the Tempo datasource.
OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:14318
# Plaintext OTLP: right for a collector on localhost or inside a cluster, wrong across
# the internet.
OTEL_EXPORTER_OTLP_INSECURE=true
# Fraction of root traces recorded. Child spans follow the parent's decision, so a
# sampled workflow is never recorded in part — a trace missing its middle looks like a
# stage that never ran.
OTEL_TRACES_SAMPLER_ARG=1.0
METRICS_ADDR=:19090

# --- worker -----------------------------------------------------------------
WORKER_GROUPS=cv,jobs,matching,applications,outreach
WORKER_CONCURRENCY=4

# --- antivirus --------------------------------------------------------------
# Empty uses the development pass-through scanner, which marks every upload
# clean without examining it. Production refuses to start without a real one.
# Start ClamAV with: docker compose --profile full up -d clamav
ANTIVIRUS_ADDR=
ANTIVIRUS_TIMEOUT=60s

# --- document extraction ----------------------------------------------------
EXTRACT_MAX_PAGES=20
EXTRACT_MAX_CHARS=200000

# --- worker -----------------------------------------------------------------
# The worker binds its own metrics port, separate from the API's.
WORKER_METRICS_ADDR=:19092

# --- embeddings -------------------------------------------------------------
# A self-hosted embedding service. Empty leaves matching on the lexical
# fallback, which is a supported mode: the Claude API has no embeddings
# endpoint, so this component is always self-hosted and always allowed to be
# absent. Matches scored lexically are marked degraded and rescored once an
# embedding service appears.
#
# Expected contract:
#   POST {EMBED_BASE_URL}/embed  {"texts": ["..."]}
#   -> {"embeddings": [[...]], "model": "all-MiniLM-L6-v2", "dims": 384}
EMBED_BASE_URL=
EMBED_TIMEOUT=30s
EMBED_MAX_BATCH=32

# How often the worker sweeps for CV versions left unembedded by an embedding outage,
# and how many it re-embeds per sweep. This sweep is what makes an outage temporary: a
# version missed while the service was down would otherwise stay on the weaker lexical
# matching signal permanently.
EMBED_BACKFILL_INTERVAL=5m
EMBED_BACKFILL_BATCH=50

# --- Job sources ------------------------------------------------------------------
#
# Each source is independently optional. An unconfigured source is reported at startup
# and left unregistered rather than failing the process, so a deployment runs with
# whichever sources it has keys for.
#
# Adzuna: self-service credentials from https://developer.adzuna.com/. The first source
# because it needs no partnership agreement.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Points at a test double. Empty uses the real API.
ADZUNA_BASE_URL=
ADZUNA_TIMEOUT=20s
# Adzuna publishes no hard rate limit, so this is deliberately conservative: being
# throttled costs a whole discovery run, while being slower costs minutes on an hourly
# schedule. The adapter enforces it internally, so a scheduling bug cannot exceed it.
ADZUNA_RATE_PER_MIN=20
